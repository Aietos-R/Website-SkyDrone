<%- include('../layouts/dashboard-start', { 
    title: 'Transaction Reports',
    page: 'report'
}) %>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card card-custom">
            <div class="card-body">
                <h5 class="card-title">Filter Reports</h5>
                <form method="GET" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Start Date</label>
                        <input type="date" class="form-control" name="start_date" value="<%= startDate %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">End Date</label>
                        <input type="date" class="form-control" name="end_date" value="<%= endDate %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Payment Method</label>
                        <select class="form-select" name="payment_method">
                            <option value="">All Methods</option>
                            <option value="cash" <%= paymentMethod === 'cash' ? 'selected' : '' %>>Cash</option>
                            <option value="qris" <%= paymentMethod === 'qris' ? 'selected' : '' %>>QRIS</option>
                            <option value="debit" <%= paymentMethod === 'debit' ? 'selected' : '' %>>Debit Card</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary-custom w-100">
                            <i class="fas fa-filter me-2"></i> Filter
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card card-custom">
            <div class="card-header">
                <h5 class="mb-0">Sales Chart</h5>
            </div>
            <div class="card-body">
                <canvas id="salesChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom">
            <div class="card-header">
                <h5 class="mb-0">Summary</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">Total Transactions</small>
                    <h3><%= summary.total_transactions %></h3>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Total Revenue</small>
                    <h3 class="text-success">Rp <%= summary.total_revenue.toLocaleString('id-ID') %></h3>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Average per Transaction</small>
                    <h5>Rp <%= summary.average_transaction.toLocaleString('id-ID') %></h5>
                </div>
                <button class="btn btn-secondary w-100" onclick="window.print()">
                    <i class="fas fa-print me-2"></i> Print Report
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card card-custom table-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Transaction Details</h5>
        <span class="badge bg-primary"><%= transactions.length %> transactions found</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Invoice</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Payment</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% transactions.forEach(transaction => { %>
                    <tr>
                        <td><strong><%= transaction.invoice %></strong></td>
                        <td><%= moment(transaction.transaction_date).format('DD/MM/YY HH:mm') %></td>
                        <td><%= transaction.customer_name %></td>
                        <td>
                            <small>
                                <% transaction.items.forEach(item => { %>
                                <%= item.quantity %>x <%= item.menu_name %><br>
                                <% }) %>
                            </small>
                        </td>
                        <td>
                            <span class="badge bg-info"><%= transaction.payment_method %></span>
                        </td>
                        <td class="text-end">
                            <strong>Rp <%= transaction.total.toLocaleString('id-ID') %></strong>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function () {
    const labels = <%= JSON.stringify(chartData && chartData.labels ? chartData.labels : []) %>;
    const dataset = <%= JSON.stringify(chartData && chartData.data ? chartData.data : []) %>;

    window.addEventListener('load', function () {
        if (typeof Chart === 'undefined') return;
        const canvas = document.getElementById('salesChart');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    label: 'Daily Revenue',
                    data: dataset,
                    borderColor: '#FF6B35',
                    backgroundColor: 'rgba(255, 107, 53, 0.1)',
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: true }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback(value) {
                                return 'Rp ' + Number(value || 0).toLocaleString('id-ID');
                            }
                        }
                    }
                }
            }
        });
    });
})();
</script>

<%- include('../layouts/dashboard-end', { scripts: ['https://cdn.jsdelivr.net/npm/chart.js'] }) %>