<%- include('../../layouts/dashboard-start', { title: 'Reservations', page: 'reservations' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><i class="fas fa-chair me-2"></i> Reservasi Meja</h4>
  <span class="badge bg-primary"><%= reservations.length %> reservasi</span>
</div>

<div class="card card-custom">
  <div class="card-body p-0">
    <% if (!reservations.length) { %>
      <div class="text-center py-5">
        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">Belum ada reservasi</h5>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th>Nama</th>
              <th>Telepon</th>
              <th>Tanggal</th>
              <th>Waktu</th>
              <th>Orang</th>
              <th>Status</th>
              <th>Alasan/Catatan</th>
              <th>Dibuat</th>
              <th width="160">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% reservations.forEach(function(r){ %>
              <tr>
                <td><%= r.name %></td>
                <td><%= r.phone %></td>
                <td><%= r.date %></td>
                <td><%= r.time %></td>
                <td><%= r.party_size %></td>
                <td><span class="badge bg-info text-dark"><%= r.status %></span></td>
                <td><%= r.reason ? r.reason : '-' %></td>
                <td><%= moment(r.created_at).format('DD MMM YYYY HH:mm') %></td>
                <td>
                  <form action="/admin/reservations/<%= r.id %>/status" method="POST" class="d-inline me-1">
                    <input type="hidden" name="status" value="approved">
                    <input type="text" name="reason" class="form-control form-control-sm d-inline-block w-auto" placeholder="Catatan (opsional)">
                    <button class="btn btn-success btn-sm"><i class="fas fa-check"></i> Approve</button>
                  </form>
                  <form action="/admin/reservations/<%= r.id %>/status" method="POST" class="d-inline me-1">
                    <input type="hidden" name="status" value="rejected">
                    <input type="text" name="reason" class="form-control form-control-sm d-inline-block w-auto" placeholder="Alasan penolakan" required>
                    <button class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Reject</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
  (function(){
    try {
      var es = new EventSource('/events/reservations');
      es.onmessage = function(ev){
        try { var data = JSON.parse(ev.data || '{}'); } catch(e) { return; }
        if (data && data.type === 'new') {
          const msg = `Reservasi baru: ${data.reservation.name || 'Pelanggan'} - ${data.reservation.date} ${data.reservation.time}`;
          console.log(msg);
          var tbody = document.querySelector('table tbody');
          if (tbody) {
            var tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${data.reservation.name || '-'}</td>
              <td>${data.reservation.phone || '-'}</td>
              <td>${data.reservation.date || '-'}</td>
              <td>${data.reservation.time || '-'}</td>
              <td>${data.reservation.party_size || '-'}</td>
              <td><span class="badge bg-info text-dark">pending</span></td>
              <td>${data.reservation.reason ? data.reservation.reason : '-'}</td>
              <td>${new Date(data.reservation.created_at || Date.now()).toLocaleString('id-ID')}</td>
              <td>
                <form action="/admin/reservations/${data.reservation.id}/status" method="POST" class="d-inline me-1">
                  <input type="hidden" name="status" value="approved">
                  <input type="text" name="reason" class="form-control form-control-sm d-inline-block w-auto" placeholder="Catatan (opsional)">
                  <button class="btn btn-success btn-sm"><i class="fas fa-check"></i> Approve</button>
                </form>
                <form action="/admin/reservations/${data.reservation.id}/status" method="POST" class="d-inline me-1">
                  <input type="hidden" name="status" value="rejected">
                  <input type="text" name="reason" class="form-control form-control-sm d-inline-block w-auto" placeholder="Alasan penolakan" required>
                  <button class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Reject</button>
                </form>
              </td>
            `;
            tbody.prepend(tr);
          } else {
            location.reload();
          }
        }
      };
      es.onerror = function(){
        // Fallback polling if SSE fails
        setTimeout(function(){ location.reload(); }, 30000);
      };
    } catch(e) { console.warn('SSE init failed', e); }
  })();
</script>

<%- include('../../layouts/dashboard-end') %>
