<%- include('../layouts/dashboard-start', { 
  title: 'Dashboard',
  page: 'dashboard'
}) %>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card card-custom stat-card">
      <div class="card-body">
        <p class="text-muted mb-1">Total Menu</p>
        <h2><%= menuStats.total_menus || 0 %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-custom stat-card">
      <div class="card-body">
        <p class="text-muted mb-1">Transaksi Hari Ini</p>
        <h2><%= menuStats.today_transactions || 0 %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-custom stat-card">
      <div class="card-body">
        <p class="text-muted mb-1">Revenue Bulan Ini</p>
        <h2>Rp <%= (menuStats.month_revenue || 0).toLocaleString('id-ID') %></h2>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card card-custom stat-card">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <p class="text-muted mb-1">Pesanan Online Pending</p>
          <h2><%= pendingCounts.pending_online_orders %></h2>
        </div>
        <a href="/admin/online-orders" class="btn btn-warning text-dark">Lihat</a>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card card-custom stat-card">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <p class="text-muted mb-1">Reservasi Pending</p>
          <h2><%= pendingCounts.pending_reservations %></h2>
        </div>
        <a href="/admin/reservations" class="btn btn-info">Lihat</a>
      </div>
    </div>
  </div>
</div>


<div class="row g-3 mb-4">
  <div class="col-lg-8">
    <div class="card card-custom">
      <div class="card-header d-flex justify-content-between">
        <h5 class="mb-0">Grafik Penjualan 7 Hari</h5>
      </div>
      <div class="card-body">
        <canvas id="dashboardChart" height="120"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card card-custom">
      <div class="card-header">
        <h5 class="mb-0">Menu Populer</h5>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <% popularMenus.forEach(menu => { %>
            <li class="list-group-item d-flex justify-content-between">
              <span><%= menu.name %></span>
              <strong><%= menu.sold %>x</strong>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="card card-custom table-custom">
  <div class="card-header d-flex justify-content-between">
    <h5 class="mb-0">Transaksi Terbaru</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table mb-0">
        <thead class="table-light">
          <tr>
            <th>Invoice</th>
            <th>Customer</th>
            <th>Cashier</th>
            <th>Tanggal</th>
            <th class="text-end">Total</th>
          </tr>
        </thead>
        <tbody>
          <% recentTransactions.forEach(trx => { %>
            <tr>
              <td><%= trx.invoice %></td>
              <td><%= trx.customer_name || 'Walk-in Customer' %></td>
              <td><%= trx.cashier %></td>
              <td><%= moment(trx.transaction_date).format('DD/MM/YYYY HH:mm') %></td>
              <td class="text-end">Rp <%= (trx.total || 0).toLocaleString('id-ID') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
window.addEventListener('load', function () {
  if (typeof Chart === 'undefined') return;
  const canvas = document.getElementById('dashboardChart');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  const labels = <%- JSON.stringify(chartData.labels || []) %>;
  const data = <%- JSON.stringify(chartData.data || []) %>;
  
  if (labels.length === 0 || data.length === 0) {
    canvas.parentElement.innerHTML = '<p class="text-muted text-center">No data available for chart</p>';
    return;
  }

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [{
        label: 'Revenue',
        data: data,
        borderColor: '#FF6B35',
        backgroundColor: 'rgba(255,107,53,0.1)',
        tension: 0.4,
        fill: true
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          display: true,
          position: 'top'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: function(value) {
              return 'Rp ' + value.toLocaleString('id-ID');
            }
          }
        }
      }
    }
  });
});
</script>

<%- include('../layouts/dashboard-end', { scripts: ['https://cdn.jsdelivr.net/npm/chart.js'] }) %>
