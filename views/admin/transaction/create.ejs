<%- include('../../layouts/dashboard-start', { 
    title: 'New Transaction',
    page: 'transaction'
}) %>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-shopping-cart me-2"></i>Order Items</h5>
            </div>
            <div class="card-body">
                <form id="transactionForm" action="/transactions" method="POST">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Customer Name</label>
                            <input type="text" class="form-control" name="customer_name" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Payment Method</label>
                            <select class="form-select" name="payment_method">
                                <option value="cash">Cash</option>
                                <option value="qris">QRIS</option>
                                <option value="debit">Debit Card</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="table-responsive mb-3">
                        <table class="table" id="itemsTable">
                            <thead>
                                <tr>
                                    <th width="40%">Menu Item</th>
                                    <th width="20%">Price</th>
                                    <th width="15%">Quantity</th>
                                    <th width="20%">Subtotal</th>
                                    <th width="5%"></th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody">
                                <!-- Rows will be added here dynamically -->
                                <tr class="item-row">
                                    <td>
                                        <select class="form-select menu-select" name="items[0][menu_id]" required>
                                            <option value="">Select Menu</option>
                                            <% menus.forEach(menu => { %>
                                            <option value="<%= menu.id %>" data-price="<%= menu.price %>">
                                                <%= menu.name %> - Rp <%= menu.price.toLocaleString('id-ID') %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control price-input" name="items[0][price]" readonly>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control quantity-input" 
                                               name="items[0][quantity]" min="1" value="1" required>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control subtotal-input" readonly>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm remove-row" disabled>
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5">
                                        <button type="button" class="btn btn-outline-primary" id="addRow">
                                            <i class="fas fa-plus me-2"></i> Add Another Item
                                        </button>
                                    </td>
                                </tr>
                                <tr class="table-secondary">
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td colspan="2">
                                        <h4 class="text-success mb-0" id="grandTotal">Rp 0</h4>
                                        <input type="hidden" name="total" id="totalInput">
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="/transactions" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary-custom">
                            <i class="fas fa-save me-2"></i> Save Transaction
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card card-custom mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Quick Stats</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">Today's Date</small>
                    <h5><%= moment().format('DD MMMM YYYY') %></h5>
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Invoice Number</small>
                    <h5>INV-<%= moment().format('YYYYMMDD') %>-001</h5>
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Cashier</small>
                    <h5><%= user.full_name %></h5>
                </div>
                
                <hr>
                
                <h6>Popular Items:</h6>
                <ul class="list-group list-group-flush">
                    <% popularMenus.forEach(menu => { %>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span><%= menu.name %></span>
                        <button type="button" class="btn btn-sm btn-outline-primary add-popular" 
                                data-id="<%= menu.id %>" data-name="<%= menu.name %>" data-price="<%= menu.price %>">
                            <i class="fas fa-plus"></i>
                        </button>
                    </li>
                    <% }) %>
                </ul>
            </div>
        </div>
    </div>
</div>

<%- include('../../layouts/dashboard-end', { scripts: ['/js/dynamic-rows.js'] }) %>
