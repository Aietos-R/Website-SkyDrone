<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SkyDrone</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="hero-section text-center text-white">
    <div class="container">
      <img src="/images/logo.png" alt="SkyDrone" class="hero-logo mb-4">
      <h1>SkyDrone</h1>
      <p class="lead">Platform layanan logistik udara terdepan</p>
      <p class="lead">Nikmati pengalaman kirim paket dan pesan makanan via drone dengan cepat dan mudah</p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <% if (user && (user.role === 'admin' || user.role === 'lecturer')) { %>
          <a href="/admin" class="btn btn-primary btn-lg">Admin Dashboard</a>
        <% } else if (user && (user.role === 'customer' || user.role === 'student')) { %>
          <a href="/customer/order" class="btn btn-primary btn-lg">Pesan Online</a>
          <a href="/customer/reserve" class="btn btn-warning btn-lg">Reservasi Meja</a>
        <% } else { %>
          <a href="/login" class="btn btn-light btn-lg">Login</a>
          <a href="/signup" class="btn btn-outline-light btn-lg">Daftar</a>
        <% } %>
      </div>
    </div>
  </header>

  

  <footer class="py-4 text-center text-muted">
    <small>© <%= new Date().getFullYear() %> PT. El Cepat Abadi</small>
  </footer>
</body>
</html>

