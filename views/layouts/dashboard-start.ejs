<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | SkyDrone </title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse">
                <div class="logo d-flex align-items-center gap-2">
                    <img src="/images/logo.png" alt="SkyDrone" class="sidebar-logo-img">
                    <div>
                        <h4 class="mb-0">SkyDrone</h4>
                        <small class="text-muted">CMS Admin Panel</small>
                    </div>
                </div>
                
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link <%= page === 'dashboard' ? 'active' : '' %>" href="/admin">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </li>
                        
                        <% if (user.role === 'admin' || user.role === 'lecturer') { %>
                        <li class="nav-item">
                            <a class="nav-link <%= page === 'menu' ? 'active' : '' %>" href="/admin/menu">
                                <i class="fas fa-hamburger"></i> Menu Management
                            </a>
                        </li>
                        <% } %>
                        
                        <li class="nav-item">
                            <a class="nav-link <%= page === 'transaction' ? 'active' : '' %>" href="/transactions">
                                <i class="fas fa-shopping-cart"></i> Transactions
                            </a>
                        </li>
                        
                        <% if (user.role === 'admin' || user.role === 'lecturer') { %>
                        <li class="nav-item">
                            <a class="nav-link <%= page === 'report' ? 'active' : '' %>" href="/admin/reports">
                                <i class="fas fa-chart-bar"></i> Reports
                            </a>
                        </li>
                        <% } %>

                        <% if (user.role === 'admin') { %>
                        <li class="nav-item">
                            <a class="nav-link <%= page === 'online_orders' ? 'active' : '' %>" href="/admin/online-orders">
                                <i class="fas fa-receipt"></i> Online Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= page === 'reservations' ? 'active' : '' %>" href="/admin/reservations">
                                <i class="fas fa-chair"></i> Reservations
                            </a>
                        </li>
                        <% } %>
                        
                        <li class="nav-item mt-5">
                            <div class="px-3 py-2">
                                <small class="text-muted">Logged in as:</small>
                                <h6 class="mb-0"><%= user.full_name %></h6>
                                <small class="text-muted d-block">@<%= user.username %></small>
                                <span class="badge bg-info"><%= ({admin:'Admin', lecturer:'Dosen', student:'Mahasiswa', customer:'Pelanggan'})[user.role] || user.role %></span>
                            </div>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="/logout">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
            
            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080;"></div>
                <div id="flashData" data-success="<%= Array.isArray(success_msg) && success_msg.length ? success_msg[0] : '' %>" data-error="<%= Array.isArray(error_msg) && error_msg.length ? error_msg[0] : '' %>" style="display:none"></div>
                
                <!-- Page Title -->
                <div class="pt-3 pb-2 mb-2 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                      <h1 class="h2 mb-0"><%= title %></h1>
                      <div class="btn-toolbar">
                          <%- typeof headerButtons !== 'undefined' ? headerButtons : '' %>
                      </div>
                    </div>
                    <nav aria-label="breadcrumb" class="mt-2">
                      <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><%= title %></li>
                      </ol>
                    </nav>
                </div>

                
                
                <!-- Page Content -->

