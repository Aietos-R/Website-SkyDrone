<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | SkyDrone </title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/customer-dashboard.css">
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="/customer/beranda">
                <div class="brand-logo">
                    <img src="/images/logo.png" alt="SkyDrone" class="brand-logo-img me-2">
                    <span style="color: #330066;">Sky</span><span style="color: #2563eb;">Drone</span>
                </div>
            </a>
            
            <div class="d-flex align-items-center ms-auto">
                
                <div class="nav-item dropdown me-2 me-lg-0">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar me-lg-2">
                            <i class="fas fa-user-circle" style="font-size: 1.8rem;"></i>
                        </div>
                        <div class="user-info d-none d-lg-block">
                            <div class="user-name"><%= user ? user.full_name : 'User' %></div>
                            <small class="user-role text-muted"><%= user ? ({customer:'Pelanggan', student:'Mahasiswa', admin:'Admin', lecturer:'Dosen'})[user.role] || user.role : '' %></small>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-custom position-absolute" aria-labelledby="navbarDropdown">
                        <li>
                            <div class="dropdown-header">
                                <div class="d-flex align-items-center">
                                    <div class="user-avatar-lg me-3">
                                        <i class="fas fa-user-circle fa-2x text-primary"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0"><%= user ? user.full_name : '' %></h6>
                                        <small class="text-muted"><%= user ? user.username : '' %></small>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/customer/profile"><i class="fas fa-user me-2"></i>Profil Saya</a></li>
                        <li><a class="dropdown-item" href="/customer/orders"><i class="fas fa-history me-2"></i>Riwayat Pesanan</a></li>
                        <li><a class="dropdown-item" href="/customer/reservations"><i class="fas fa-chair me-2"></i>Riwayat Reservasi</a></li>
                        <li><a class="dropdown-item" href="/customer/settings"><i class="fas fa-cog me-2"></i>Pengaturan</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form action="/logout" method="POST" class="d-inline w-100">
                                <button type="submit" class="dropdown-item text-danger w-100">
                                    <i class="fas fa-sign-out-alt me-2"></i>Keluar
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                <button class="navbar-toggler border-0 shadow-none px-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

            </div>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mt-3 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'beranda' || page === 'home' ? 'active' : '' %>" href="/customer/beranda">
                            <i class="fas fa-home me-1"></i> Beranda
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'restaurant' ? 'active' : '' %>" href="/customer/restaurant">
                            <i class="fas fa-store me-1"></i> Restoran
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= page === 'cart' ? 'active' : '' %>" href="/customer/cart">
                            <i class="fas fa-shopping-cart me-1"></i> Keranjang
                            <span class="badge bg-danger ms-1" style="display: <%= cartCount && cartCount > 0 ? 'inline-block' : 'none' %>;"><%= cartCount || 0 %></span>
                        </a>
                    </li>

                    <!-- <li class="nav-item">
                        <a class="nav-link <%= page === 'orders' ? 'active' : '' %>" href="/customer/orders">
                            <i class="fas fa-list me-1"></i> Pesanan Saya
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= page === 'reservations' ? 'active' : '' %>" href="/customer/reservations">
                            <i class="fas fa-chair me-1"></i> Reservasi Saya
                        </a>
                    </li> -->
                    
                    </ul>
            </div>
        </div>
    </nav>

