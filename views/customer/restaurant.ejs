<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchResto');
    const regionSections = document.querySelectorAll('.region-section');
    const noResultMsg = document.getElementById('no-result-msg');

    searchInput.addEventListener('keyup', function() {
        const filter = this.value.toLowerCase();
        let totalVisibleCards = 0;

        // Cek setiap wilayah (Jakarta Selatan, Pusat, Barat)
        regionSections.forEach(section => {
            const cards = section.querySelectorAll('.resto-card');
            let visibleCardsInRegion = 0;

            // Cek setiap kartu resto di wilayah tersebut
            cards.forEach(card => {
                const name = card.querySelector('.resto-name').textContent.toLowerCase();
                const tags = card.querySelector('.resto-tags').textContent.toLowerCase();

                if (name.includes(filter) || tags.includes(filter)) {
                    card.style.display = '';
                    visibleCardsInRegion++;
                    totalVisibleCards++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (visibleCardsInRegion === 0) {
                section.style.display = 'none';
            } else {
                section.style.display = '';
            }
        });

        if (totalVisibleCards === 0) {
            noResultMsg.style.display = 'block';
        } else {
            noResultMsg.style.display = 'none';
        }
    });
});
</script>

