<%
  // Ini adalah nilai bawaan (default) jika data tidak diisi saat dipanggil
  const name = typeof restoName !== 'undefined' ? restoName : 'Nama Restoran';
  const logo = typeof restoLogo !== 'undefined' ? restoLogo : '/images/placeholders/menu.svg';
  const rating = typeof restoRating !== 'undefined' ? restoRating : '0.0';
  const reviews = typeof restoReviews !== 'undefined' ? restoReviews : '0';
  const address = typeof restoAddress !== 'undefined' ? restoAddress : 'Lokasi belum diatur';
  const hours = typeof restoHours !== 'undefined' ? restoHours : 'Jam buka belum diatur';
%>

<div style="position: sticky; top: 90px; z-index: 10;">
    
    <div class="card card-custom border-0 shadow-sm mb-4 bg-gradient-primary text-white text-center p-4 hover-lift">
        <div class="icon-circle bg-white mx-auto mb-3 shadow-sm" style="width: 80px; height: 80px; padding: 5px;">
            <img src="<%= logo %>" class="w-100 h-100 rounded-circle" style="object-fit: cover;" alt="Logo <%= name %>">
        </div>
        <h4 class="fw-bold mb-1"><%= name %></h4>
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">
            <i class="fas fa-star me-1"></i> <%= rating %> (<%= reviews %> Ulasan)
        </span>
    </div>

    <div class="card card-custom border-0 shadow-sm mb-4 bg-white">
        <div class="card-body p-3">
            <div class="d-flex align-items-center bg-light rounded-pill px-3 py-2 border">
                <i class="fas fa-search text-muted me-2"></i>
                <input type="text" id="searchMenu" class="form-control border-0 bg-transparent shadow-none p-0" placeholder="Cari nama menu..." style="font-size: 0.95rem;">
            </div>
        </div>
    </div>

    <div class="card card-custom border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom fw-bold py-3 text-dark">
            <i class="fas fa-list me-2 text-primary"></i> Kategori Menu
        </div>
        <div class="list-group list-group-flush rounded-bottom">
            <a href="#kat-makanan" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 text-dark">
                <span><i class="fas fa-hamburger text-primary me-2"></i> Makanan Utama</span>
                <i class="fas fa-chevron-right text-muted" style="font-size: 0.8rem;"></i>
            </a>
            <a href="#kat-minuman" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 text-dark">
                <span><i class="fas fa-coffee text-info me-2"></i> Minuman Segar</span>
                <i class="fas fa-chevron-right text-muted" style="font-size: 0.8rem;"></i>
            </a>
            <a href="#kat-side_dish" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 text-dark">
                <span><i class="fas fa-plate-wheat text-success me-2"></i> Side Dish</span>
                <i class="fas fa-chevron-right text-muted" style="font-size: 0.8rem;"></i>
            </a>
            <a href="#kat-paket" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 text-dark">
                <span><i class="fas fa-box text-danger me-2"></i> Paket</span>
                <i class="fas fa-chevron-right text-muted" style="font-size: 0.8rem;"></i>
            </a>
        </div>
    </div>

    <div class="card card-custom border-0 shadow-sm bg-white">
        <div class="card-body">
            <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                <i class="fas fa-info-circle text-primary me-2"></i>Info Outlet
            </h6>
            <div class="d-flex mb-3">
                <i class="fas fa-clock text-success mt-1 me-3 fs-5"></i>
                <div>
                    <span class="d-block fw-bold text-dark fs-6">Jam Buka</span>
                    <small class="text-muted"><%= hours %></small>
                </div>
            </div>
            <div class="d-flex">
                <i class="fas fa-map-marker-alt text-danger mt-1 me-3 fs-5" style="margin-left: 2px;"></i>
                <div>
                    <span class="d-block fw-bold text-dark fs-6">Lokasi Restoran</span>
                    <small class="text-muted"><%= address %></small>
                </div>
            </div>
        </div>
    </div>

</div>