<div class="container mt-5 mb-4" style="position: relative; z-index: 10;">
  <div class="row">
    <div class="col-md-3 mb-3">
      <div class="card bg-gradient-primary text-white h-100 border-0 shadow-custom hover-lift">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="card-title mb-1">Menu Tersedia</h6>
              <h3 class="mb-0">
                <% let totalMenu = 0; %>
                <% Object.values(categories).forEach(cat => totalMenu += cat.length); %>
                <%= totalMenu %>
              </h3>
            </div>
            <div class="icon-circle bg-white bg-opacity-25">
              <i class="fas fa-utensils fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 mb-3">
      <div class="card bg-gradient-info text-white h-100 border-0 shadow-custom hover-lift">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="card-title mb-1">Keranjang</h6>
              <h3 class="mb-0" id="cart-count"><%= cartCount %></h3>
            </div>
            <div class="icon-circle bg-white bg-opacity-25">
              <i class="fas fa-shopping-cart fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 mb-3">
      <div class="card bg-gradient-success text-white h-100 border-0 shadow-custom hover-lift">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="card-title mb-1">Total Belanja</h6>
              <h3 class="mb-0" id="cart-total">Rp <%= (cartTotal || 0).toLocaleString('id-ID') %></h3>
            </div>
            <div class="icon-circle bg-white bg-opacity-25">
              <i class="fas fa-coins fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-3 mb-3">
      <div class="card bg-gradient-warning text-dark h-100 border-0 shadow-custom hover-lift">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="card-title mb-1">Promo Hari Ini</h6>
              <h5 class="mb-0">Gratis Ongkir!</h5>
            </div>
            <div class="icon-circle bg-dark bg-opacity-25">
              <i class="fas fa-gift fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-12">
    <div class="card card-custom">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="search-container">
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-light border-0">
                  <i class="fas fa-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-0 bg-light" id="searchInput" 
                       placeholder="Cari menu favoritmu..." autocomplete="off">
                <button class="btn btn-outline-secondary border-0" type="button" id="clearSearch" style="display: none;">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <select class="form-select form-select-lg" id="categoryFilter">
              <option value="">Semua Kategori</option>
              <option value="ayam">Ayam</option>
              <option value="nasi">Nasi</option>
              <option value="minuman">Minuman</option>
              <option value="side_dish">Side Dish</option>
              <option value="paket">Paket</option>
            </select>
          </div>
          <div class="col-md-3">
            <select class="form-select form-select-lg" id="sortBy">
              <option value="name">Urutkan: Nama</option>
              <option value="price_asc">Harga: Termurah</option>
              <option value="price_desc">Harga: Termahal</option>
              <option value="popular">Paling Populer</option>
            </select>
          </div>
        </div>
        
        <!-- Quick Filter Chips -->
        <div class="row mt-3">
          <div class="col-12">
            <div class="filter-chips d-flex flex-wrap gap-2" id="filterChips">
              <button class="chip chip-active" data-filter="all">Semua</button>
              <button class="chip" data-filter="promo">
                <i class="fas fa-fire me-1"></i>Promo
              </button>
              <button class="chip" data-filter="new">
                <i class="fas fa-star me-1"></i>Baru
              </button>
              <button class="chip" data-filter="bestseller">
                <i class="fas fa-crown me-1"></i>Best Seller
              </button>
              <button class="chip" data-filter="vegetarian">
                <i class="fas fa-leaf me-1"></i>Vegetarian
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card card-custom">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="fas fa-utensils me-2"></i>
          <span id="menuTitle">Menu Spesial Hari Ini</span>
        </h5>
        <div class="d-flex gap-2">
          <span class="badge bg-primary" id="menuCount"><%= totalMenu %> Menu</span>
          <a href="/customer/reserve" class="btn btn-sm btn-outline-warning">
            <i class="fas fa-chair"></i>
            Reservasi Meja
          </a>
          <button class="btn btn-sm btn-outline-primary" id="viewToggle" data-view="grid">
            <i class="fas fa-th"></i>
          </button>
        </div>
      </div>
      <div class="card-body p-0">
        <!-- Loading State -->
        <div id="loadingState" class="text-center py-5" style="display: none;">
          <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="text-muted">Memuat menu...</p>
        </div>
        
        <!-- No Results State -->
        <div id="noResults" class="text-center py-5" style="display: none;">
          <i class="fas fa-search fa-3x text-muted mb-3"></i>
          <h5 class="text-muted">Menu tidak ditemukan</h5>
          <p class="text-muted">Coba kata kunci lain atau ubah filter</p>
        </div>
        
        <!-- Menu Container -->
        <div id="menuContainer">
        <% const orderedCategories = ['ayam','nasi','minuman','side_dish','paket']; %>
        <% orderedCategories.forEach(function(cat){ %>
          <% const items = categories[cat] || []; %>
          <% if (!items.length) { return; } %>
          <div class="category-section p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h4 class="category-title text-capitalize mb-0">
                <i class="category-icon <%= getCategoryIcon(cat) %>"></i>
                <%= getCategoryName(cat) %>
              </h4>
              <span class="badge bg-secondary"><%= items.length %> item</span>
            </div>
            <div class="row g-3">
              <% items.forEach(function(menu){ %>
                <div class="col-md-6 col-lg-3 col-xl-3">
                  <div class="menu-card h-100">
                    <div class="menu-image-container js-quick-view" 
                         data-menu-id="<%= menu.id %>" 
                         data-menu-name="<%= menu.name %>" 
                         data-menu-price="<%= menu.price %>" 
                         data-menu-desc="<%= menu.description || '' %>" 
                         data-menu-image="<%= menu.image || '' %>" 
                         data-menu-category="<%= menu.category %>"
                         style="cursor:pointer">
                      <img src="<%= menu.image ? '/uploads/' + menu.image : '/images/placeholders/menu.svg' %>" 
                           class="menu-image" alt="<%= menu.name %>">
                      
                      <!-- Menu Badges -->
                      <div class="menu-badges position-absolute top-0 start-0 p-2">
                        <% if (menu.is_promo) { %>
                          <span class="badge bg-danger badge-promo">
                            <i class="fas fa-fire me-1"></i>Promo
                          </span>
                        <% } %>
                        <% if (menu.is_new) { %>
                          <span class="badge bg-success badge-new">
                            <i class="fas fa-star me-1"></i>Baru
                          </span>
                        <% } %>
                        <% if (menu.is_bestseller) { %>
                          <span class="badge bg-warning text-dark badge-bestseller">
                            <i class="fas fa-crown me-1"></i>Best Seller
                          </span>
                        <% } %>
                        <% if (menu.is_vegetarian) { %>
                          <span class="badge bg-info badge-vegetarian">
                            <i class="fas fa-leaf me-1"></i>Vegetarian
                          </span>
                        <% } %>
                      </div>
                      
                      <div class="menu-overlay">
                        <button class="btn btn-light btn-sm js-quick-view"
                                data-menu-id="<%= menu.id %>" 
                                data-menu-name="<%= menu.name %>" 
                                data-menu-price="<%= menu.price %>" 
                                data-menu-desc="<%= menu.description || '' %>" 
                                data-menu-image="<%= menu.image || '' %>" 
                                data-menu-category="<%= menu.category %>">
                          <i class="fas fa-eye me-1"></i>Quick View
                        </button>
                      </div>
                    </div>
                    <div class="menu-content">
                      <div class="menu-header d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                          <h6 class="menu-title"><%= menu.name %></h6>
                          <span class="menu-price">Rp <%= menu.price.toLocaleString('id-ID') %></span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary ms-2 js-quick-view"
                                data-menu-id="<%= menu.id %>" 
                                data-menu-name="<%= menu.name %>" 
                                data-menu-price="<%= menu.price %>" 
                                data-menu-desc="<%= menu.description || '' %>" 
                                data-menu-image="<%= menu.image || '' %>" 
                                data-menu-category="<%= menu.category %>">
                          <i class="fas fa-eye"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger wishlist-btn ms-2" 
                                data-menu-id="<%= menu.id %>" 
                                data-menu-name="<%= menu.name %>"
                                onclick="toggleWishlist(this)">
                          <i class="far fa-heart"></i>
                        </button>
                      </div>
                      <p class="menu-description"><%= (menu.description || '').slice(0,60) %>...</p>
                      
                      <!-- Rating -->
                      <div class="menu-rating mb-2">
                        <div class="star-rating" data-rating="<%= menu.rating || 0 %>" data-menu-id="<%= menu.id %>">
                          <% for (let i = 1; i <= 5; i++) { %>
                            <i class="fas fa-star <%= i <= (menu.rating || 0) ? 'text-warning' : 'text-muted' %>"
                               data-value="<%= i %>"
                               onclick="rateMenu('<%- menu.id %>', <%- i %>)"></i>
                          <% } %>
                        </div>
                        <small class="text-muted ms-2">
                          <%= menu.rating ? menu.rating.toFixed(1) : '0.0' %> 
                          (<%= menu.review_count || 0 %> ulasan)
                        </small>
                      </div>
                      
                      <form action="/customer/order/add" method="POST" class="order-form add-to-cart-form">
                        <input type="hidden" name="menu_id" value="<%= menu.id %>">
                        <div class="order-options">
                          <% if (cat === 'ayam') { %>
                            <div class="option-group">
                              <label class="option-label">Varian</label>
                              <select name="variant" class="form-select form-select-sm">
                                <option value="tulang">Tulang</option>
                                <option value="tanpa_tulang">Tanpa Tulang</option>
                              </select>
                            </div>
                          <% } %>
                          <% if (cat === 'nasi') { %>
                            <div class="row g-2">
                              <div class="col-6">
                                <label class="option-label">Sambal</label>
                                <select name="sambal_type" class="form-select form-select-sm">
                                  <option value="biasa">Sambal Biasa</option>
                                  <option value="matah">Sambal Matah</option>
                                  <option value="ijo">Sambal Ijo</option>
                                </select>
                              </div>
                              <div class="col-6">
                                <label class="option-label">Level Pedas</label>
                                <select name="spicy_level" class="form-select form-select-sm">
                                  <option value="0">Level 0</option>
                                  <option value="1">Level 1</option>
                                  <option value="2">Level 2</option>
                                  <option value="3">Level 3</option>
                                  <option value="4">Level 4</option>
                                  <option value="5">Level 5</option>
                                </select>
                              </div>
                            </div>
                          <% } else { %>
                            <div class="option-group">
                              <label class="option-label">Level Pedas</label>
                              <select name="spicy_level" class="form-select form-select-sm">
                                <option value="0">Level 0</option>
                                <option value="1">Level 1</option>
                                <option value="2">Level 2</option>
                                <option value="3">Level 3</option>
                                <option value="4">Level 4</option>
                                <option value="5">Level 5</option>
                              </select>
                            </div>
                          <% } %>
                        </div>
                        
                        <div class="order-actions">
                          <div class="quantity-control">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="decreaseQuantity(this)">-</button>
                            <input type="number" name="quantity" class="form-control form-control-sm" min="1" value="1" readonly>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="increaseQuantity(this)">+</button>
                          </div>
                          <button type="submit" class="btn btn-primary btn-sm add-to-cart-btn" 
                                  data-menu-id="<%= menu.id %>" 
                                  data-menu-name="<%= menu.name %>" 
                                  data-menu-price="<%= menu.price %>">
                            <i class="fas fa-cart-plus me-1"></i>Tambah
                          </button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
          <hr class="m-0">
        <% }) %>
      </div>
    </div>
  </div>
  
  <div class="col-12">
    <div class="card card-custom sticky-cart">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="fas fa-shopping-cart me-2"></i>
          Keranjang Belanja
        </h5>
        <span class="badge bg-primary" id="cart-badge"><%= cartCount || 0 %></span>
      </div>
      <div class="card-body">
        <div id="cart-items" class="cart-items">
          <div class="empty-cart text-center py-4" style="<%= cartCount > 0 ? 'display:none;' : '' %>">
            <i class="fas fa-shopping-basket fa-3x text-muted mb-3"></i>
            <p class="text-muted">Keranjang masih kosong</p>
            <small class="text-muted">Ayo tambahkan menu favoritmu!</small>
          </div>
        </div>
        <div class="cart-summary" id="cart-summary" style="<%= cartCount > 0 ? '' : 'display:none;' %>">
          <hr>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Total:</h6>
            <h5 class="mb-0 text-primary" id="cart-total-amount">Rp <%= (cartTotal || 0).toLocaleString('id-ID') %></h5>
          </div>
          <a href="/customer/cart" class="btn btn-success w-100">
            <i class="fas fa-cash-register me-2"></i>
            Lanjut ke Checkout
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalMenuName"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <img id="modalMenuImage" class="img-fluid rounded mb-3" alt="">
        <p id="modalMenuDescription"></p>
        <h4 class="text-primary" id="modalMenuPrice"></h4>
        <div id="modalOptions" class="mt-3"></div>
        <div class="d-flex align-items-center justify-content-between mt-3">
          <div class="quantity-control">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="modalDecreaseQuantity()">-</button>
            <input type="number" id="modalQty" class="form-control form-control-sm" min="1" value="1" readonly>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="modalIncreaseQuantity()">+</button>
          </div>
          <button type="button" id="modalAddBtn" class="btn btn-primary" onclick="addQuickViewToCart()">
            <i class="fas fa-cart-plus me-1"></i>Tambah ke Keranjang
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .card-custom {
    border: none;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border-radius: 15px;
    overflow: hidden;
  }
  
  .bg-gradient-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }
  
  .bg-gradient-info {
    background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
  }
  
  .bg-gradient-success {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  }
  
  .bg-gradient-warning {
    background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
  }
  
  .icon-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .category-section {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  }
  
  .category-title {
    color: #495057;
    font-weight: 600;
  }
  
  .category-icon {
    margin-right: 10px;
    color: #007bff;
  }
  
  .menu-card {
    border: none;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
    overflow: hidden;
  }
  
  .menu-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  }
  
  .menu-image-container {
    position: relative;
    overflow: hidden;
    height: 180px;
  }
  
  .menu-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .menu-card:hover .menu-image {
    transform: scale(1.1);
  }
  
  .menu-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .menu-card:hover .menu-overlay {
    opacity: 1;
  }
  
  .menu-content {
    padding: 1.25rem;
  }
  
  .menu-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 0.5rem;
  }
  
  .menu-title {
    font-weight: 600;
    color: #212529;
    margin-bottom: 0;
  }
  
  .menu-price {
    color: #28a745;
    font-weight: 700;
    font-size: 1.1rem;
  }
  
  .menu-description {
    color: #6c757d;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }
  
  .order-form {
    margin-top: 1rem;
  }
  
  .order-options {
    margin-bottom: 1rem;
  }
  
  .option-group {
    margin-bottom: 0.75rem;
  }
  
  .option-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #495057;
    margin-bottom: 0.25rem;
    display: block;
  }
  
  .order-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  
  .quantity-control {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .quantity-control .form-control {
    width: 50px;
    text-align: center;
    border-radius: 5px;
  }
  
  .quantity-control .btn {
    width: 30px;
    height: 30px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  
  .sticky-cart {
    position: sticky;
    top: 20px;
  }
  
  .cart-items {
    max-height: 300px;
    overflow-y: auto;
  }
  
  .empty-cart {
    opacity: 0.7;
  }
  
  .cart-item {
    padding: 0.75rem;
    border-bottom: 1px solid #e9ecef;
    background: white;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }
  
  .cart-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }
  
  @media (max-width: 768px) {
    .menu-header {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .order-actions {
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .quantity-control {
      justify-content: center;
    }
  }
</style>

<script>
  function quickView(menu) {
    document.getElementById('modalMenuName').textContent = menu.name;
    document.getElementById('modalMenuImage').src = menu.image ? '/uploads/' + menu.image : '/images/placeholders/menu.svg';
    document.getElementById('modalMenuDescription').textContent = menu.description || 'Tidak ada deskripsi';
    document.getElementById('modalMenuPrice').textContent = 'Rp ' + menu.price.toLocaleString('id-ID');
    document.getElementById('modalQty').value = 1;
    document.getElementById('modalAddBtn').dataset.menuId = menu.id;
    document.getElementById('modalAddBtn').dataset.category = menu.category;
    renderModalOptions(menu);
    new bootstrap.Modal(document.getElementById('quickViewModal')).show();
  }
  document.addEventListener('click', function(e){
    var el = e.target.closest('.js-quick-view');
    if (!el) return;
    var menu = {
      id: parseInt(el.dataset.menuId, 10),
      name: el.dataset.menuName || '',
      price: Number(el.dataset.menuPrice || 0),
      description: el.dataset.menuDesc || '',
      image: el.dataset.menuImage || '',
      category: el.dataset.menuCategory || ''
    };
    quickView(menu);
  });

  function updateCartUI(count, total){
    var navbarBadge = document.querySelector('.navbar .badge');
    if (navbarBadge && typeof count !== 'undefined') {
      navbarBadge.textContent = count;
      navbarBadge.style.display = count > 0 ? 'inline-block' : 'none';
    }
    var stickyBadge = document.getElementById('cart-badge');
    if (stickyBadge && typeof count !== 'undefined') stickyBadge.textContent = count;
    var countEl = document.getElementById('cart-count');
    if (countEl && typeof count !== 'undefined') countEl.textContent = count;
    var totalEl = document.getElementById('cart-total');
    if (totalEl && typeof total !== 'undefined') totalEl.textContent = 'Rp ' + Number(total).toLocaleString('id-ID');
    var stickyTotalEl = document.getElementById('cart-total-amount');
    if (stickyTotalEl && typeof total !== 'undefined') stickyTotalEl.textContent = 'Rp ' + Number(total).toLocaleString('id-ID');
    var empty = document.querySelector('#cart-items .empty-cart');
    var summary = document.getElementById('cart-summary');
    if (summary) summary.style.display = (count > 0) ? '' : 'none';
    if (empty) empty.style.display = (count > 0) ? 'none' : '';
    try { window.dispatchEvent(new CustomEvent('cart:update', { detail: { count: count, total: total } })); } catch(e) {}
  }
  function renderModalOptions(menu) {
    var html = '';
    if (menu.category === 'ayam') {
      html += '<div class="row g-2">';
      html += '<div class="col-6"><label class="option-label">Varian</label><select id="modalVariant" class="form-select form-select-sm"><option value="tulang">Tulang</option><option value="tanpa_tulang">Tanpa Tulang</option></select></div>';
      html += '<div class="col-6"><label class="option-label">Level Pedas</label><select id="modalSpicy" class="form-select form-select-sm"><option value="0">Level 0</option><option value="1">Level 1</option><option value="2">Level 2</option><option value="3">Level 3</option><option value="4">Level 4</option><option value="5">Level 5</option></select></div>';
      html += '</div>';
    } else if (menu.category === 'nasi') {
      html += '<div class="row g-2">';
      html += '<div class="col-6"><label class="option-label">Sambal</label><select id="modalSambal" class="form-select form-select-sm"><option value="biasa">Sambal Biasa</option><option value="matah">Sambal Matah</option><option value="ijo">Sambal Ijo</option></select></div>';
      html += '<div class="col-6"><label class="option-label">Level Pedas</label><select id="modalSpicy" class="form-select form-select-sm"><option value="0">Level 0</option><option value="1">Level 1</option><option value="2">Level 2</option><option value="3">Level 3</option><option value="4">Level 4</option><option value="5">Level 5</option></select></div>';
      html += '</div>';
    } else {
      html += '<div class="option-group"><label class="option-label">Level Pedas</label><select id="modalSpicy" class="form-select form-select-sm"><option value="0">Level 0</option><option value="1">Level 1</option><option value="2">Level 2</option><option value="3">Level 3</option><option value="4">Level 4</option><option value="5">Level 5</option></select></div>';
    }
    document.getElementById('modalOptions').innerHTML = html;
  }
  function modalIncreaseQuantity() {
    var input = document.getElementById('modalQty');
    input.value = parseInt(input.value) + 1;
  }
  function modalDecreaseQuantity() {
    var input = document.getElementById('modalQty');
    if (parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;
  }
  function addQuickViewToCart() {
    var btn = document.getElementById('modalAddBtn');
    var id = btn.dataset.menuId;
    var qty = parseInt(document.getElementById('modalQty').value) || 1;
    var spicy = document.getElementById('modalSpicy') ? document.getElementById('modalSpicy').value : 0;
    var sambal = document.getElementById('modalSambal') ? document.getElementById('modalSambal').value : null;
    var variant = document.getElementById('modalVariant') ? document.getElementById('modalVariant').value : null;
    var params = new URLSearchParams();
    params.append('menu_id', id);
    params.append('quantity', qty);
    if (spicy !== null) params.append('spicy_level', spicy);
    if (sambal !== null) params.append('sambal_type', sambal);
    if (variant !== null) params.append('variant', variant);
    fetch('/customer/order/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: params.toString()
    }).then(function(r){ return r.json(); }).then(function(data){
      if (data && data.success) {
        updateCartUI(data.cartCount, data.total);
        try { showNotification('Ditambahkan ke keranjang', 'success'); } catch(e) {}
        bootstrap.Modal.getInstance(document.getElementById('quickViewModal')).hide();
      } else {
        try { showNotification('Gagal menambahkan ke keranjang', 'error'); } catch(e) {}
      }
    }).catch(function(){
      try { showNotification('Terjadi kesalahan', 'error'); } catch(e) {}
    });
  }
  
  function increaseQuantity(button) {
    const input = button.parentElement.querySelector('input[type="number"]');
    input.value = parseInt(input.value) + 1;
  }
  
  function decreaseQuantity(button) {
    const input = button.parentElement.querySelector('input[type="number"]');
    if (parseInt(input.value) > 1) {
      input.value = parseInt(input.value) - 1;
    }
  }
  
  // Update cart display (placeholder - implement with actual cart data)
  function updateCartDisplay() {
    // Get cart data from navbar badge
    const cartBadge = document.querySelector('.navbar .badge');
    const cartCount = cartBadge ? parseInt(cartBadge.textContent) || 0 : 0;
    
    // Update sticky cart sidebar
    document.getElementById('cart-count').textContent = cartCount;
    document.getElementById('cart-badge').textContent = cartCount;
    
    // Total belanja di bagian atas diisi dari server; akan diperbarui saat add-to-cart
  }
  
  function updateStickyCartCount() {
    // Sync sticky cart with navbar cart count
    const navbarCartBadge = document.querySelector('.navbar .badge');
    const stickyCartBadge = document.getElementById('cart-badge');
    const stickyCartCount = document.getElementById('cart-count');
    
    if (navbarCartBadge && stickyCartBadge && stickyCartCount) {
      const count = parseInt(navbarCartBadge.textContent) || 0;
      stickyCartBadge.textContent = count;
      stickyCartCount.textContent = count;
      
      // Add animation to sticky cart
      if (count > 0) {
        stickyCartBadge.style.display = 'inline-block';
        stickyCartBadge.style.animation = 'cartPulse 0.3s ease-in-out';
        setTimeout(() => {
          stickyCartBadge.style.animation = '';
        }, 300);
      }
    }
  }
  
  // Initialize
  document.addEventListener('DOMContentLoaded', function() {
    updateCartDisplay();
    try { window.addEventListener('cart:update', function(e){ var d = e.detail || {}; updateCartUI(d.count, d.total); }); } catch(e) {}
    
    // Simple add to cart handler
    const addToCartForms = document.querySelectorAll('.add-to-cart-form');
    addToCartForms.forEach(form => {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        console.log('Form submitted!');
        
        const formData = new FormData(this);
        const urlParams = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
          urlParams.append(key, value);
        }
        const submitBtn = this.querySelector('.add-to-cart-btn');
        const originalText = submitBtn.innerHTML;
        
        // Show loading state
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Menambah...';
        submitBtn.disabled = true;
        
        try {
          const response = await fetch('/customer/order/add', {
            method: 'POST',
            body: urlParams,
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            credentials: 'same-origin',
            cache: 'no-store'
          });
          
          console.log('Response status:', response.status);
          const data = await response.json();
          console.log('Response data:', data);
          
          if (response.ok && data.success) {
            const menuName = submitBtn.dataset.menuName;
            alert(`${menuName} berhasil ditambahkan ke keranjang!`);
            updateCartUI(data.cartCount, data.total);
            this.reset();
            this.querySelector('input[name="quantity"]').value = 1;
          } else {
            alert(data.message || 'Gagal menambahkan ke keranjang');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Terjadi kesalahan saat menambahkan ke keranjang');
        } finally {
          // Reset button state
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    });
  });
</script>

<%- include('../layouts/customer-end') %>
