<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/images/logo.jpg" alt="Ayam Geprek Arema" class="brand-logo-img me-2">
        <span>Ayam Geprek Arema</span>
      </a>
      <a class="btn btn-outline-secondary" href="/customer/order">Belanja Lagi</a>
    </div>
  </nav>

  <div class="container py-4">
    <h2 class="mb-3">Checkout</h2>
    <div class="alert alert-info">Pesanan berhasil disimpan. Menunggu ACC Admin.</div>

    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <div>Invoice</div>
            <h5><%= invoice %></h5>
          </div>
          <div class="text-end">
            <div>Total</div>
            <h5>Rp <%= total.toLocaleString('id-ID') %></h5>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header">Ringkasan Pesanan</div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <% cart.forEach(function(it){ %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span>
                <strong><%= it.name %></strong>
                <% if (it.options.variant) { %> - <%= it.options.variant %> <% } %>
                <% if (it.options.sambal_type) { %> - <%= it.options.sambal_type %> <% } %>
                - Pedas <%= it.options.spicy_level %>
              </span>
              <span>x<%= it.quantity %> · Rp <%= (it.price * it.quantity).toLocaleString('id-ID') %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Pembayaran Online</span>
        <span class="badge bg-primary" id="countdownBadge">Mulai dalam 10s</span>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label">Metode Pembayaran</label>
          <select class="form-select" id="paymentMethod">
            <option value="qris" selected>QRIS</option>
            <option value="cash">Cash (di kasir)</option>
            <option value="debit">Kartu Debit</option>
          </select>
        </div>
        <div id="qrContainer" class="text-center p-4" style="display:none">
          <div class="mb-2">Silakan scan QR berikut:</div>
          <img src="/images/placeholders/qris.png" alt="QRIS" style="max-width:220px;" onerror="this.src='/images/placeholders/menu.svg'">
          <div class="text-muted mt-2">Prototipe: otomatis diset sebagai berhasil</div>
        </div>
        <div class="d-flex gap-2">
          <button id="cancelBtn" class="btn btn-outline-danger">Batalkan</button>
          <button id="startBtn" class="btn btn-primary">Mulai Pembayaran</button>
        </div>
      </div>
    </div>
  </div>

  <footer class="py-4 text-center text-muted">
    <small>© <%= new Date().getFullYear() %> PT.El Cepat Abadi</small>
  </footer>
</body>
</html>
</div>

<script>
  (function(){
    var countdown = 10;
    var timer = null;
    var started = false;
    var badge = document.getElementById('countdownBadge');
    var startBtn = document.getElementById('startBtn');
    var cancelBtn = document.getElementById('cancelBtn');
    var qrContainer = document.getElementById('qrContainer');

    function updateBadge(){
      if (!badge) return;
      badge.textContent = started ? ('Auto-bayar dalam ' + countdown + 's') : ('Tekan "Mulai Pembayaran"');
    }
    function tick(){
      countdown--;
      updateBadge();
      if (countdown <= 0) {
        clearInterval(timer);
        completePayment();
      }
    }
    function showQR(){
      qrContainer.style.display = 'block';
    }
    function completePayment(){
      var method = document.getElementById('paymentMethod').value || 'qris';
      fetch('/customer/payment/complete', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ payment_method: method })
      }).then(function(r){ return r.json(); }).then(function(data){
        if (data.success && data.redirect) {
          window.location.href = data.redirect;
        }
      });
    }
    function cancelPayment(){
      clearInterval(timer);
      started = false;
      qrContainer.style.display = 'none';
      fetch('/customer/payment/cancel', {
        method: 'POST',
        headers: { 'Accept': 'application/json' }
      }).then(function(r){ return r.json(); }).then(function(data){
        if (data.success && data.redirect) {
          window.location.href = data.redirect;
        }
      });
    }
    startBtn.addEventListener('click', function(){
      if (started) return;
      started = true;
      countdown = 10;
      showQR();
      updateBadge();
      timer = setInterval(tick, 1000);
    });
    cancelBtn.addEventListener('click', function(){
      if (started && countdown > 0) {
        cancelPayment();
      }
    });
    updateBadge();
  })();
</script>
