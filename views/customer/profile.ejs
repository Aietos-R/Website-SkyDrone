<%- include('../layouts/customer-start', {
  title: 'Profil Saya',
  page: 'profile',
  user: user,
  cartCount: cartCount
}) %>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card card-custom mb-4">
        <div class="card-header">
          <h5 class="mb-0"><i class="fas fa-user me-2"></i>Profil Saya</h5>
        </div>
        <div class="card-body">
          <form action="/customer/profile" method="POST" class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Username</label>
              <input type="text" class="form-control" value="<%= user.username %>" disabled>
            </div>
            <div class="col-md-6">
              <label class="form-label">Nomor WhatsApp</label>
              <input type="number" class="form-control" value="<%= user.nomor_whatsapp %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Nama Lengkap</label>
              <input type="text" class="form-control" name="full_name" value="<%= user.full_name %>" required>
            </div>
            <div class="col-12 text-end">
              <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Simpan Profil</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card card-custom">
        <div class="card-header">
          <h5 class="mb-0"><i class="fas fa-lock me-2"></i>Ubah Password</h5>
        </div>
        <div class="card-body">
          <form action="/customer/profile/password" method="POST" class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Password Saat Ini</label>
              <input type="password" class="form-control" name="current_password" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Password Baru</label>
              <input type="password" class="form-control" name="new_password" required>
            </div>
            <div class="col-12 text-end">
              <button type="submit" class="btn btn-outline-primary"><i class="fas fa-key me-1"></i>Ubah Password</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card card-custom mb-4">
        <div class="card-body text-center">
          <i class="fas fa-user-circle fa-5x text-primary mb-3"></i>
          <h5 class="mb-1"><%= user.full_name %></h5>
          <small class="text-muted d-block mb-2">@<%= user.username %> • <%= user.role %></small>
          <div class="small text-muted">Bergabung: <%= user.created_at ? moment(user.created_at).format('DD/MM/YY HH:mm') : '-' %></div>
        </div>
      </div>
      <div class="card card-custom">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><i class="fas fa-sliders-h me-2"></i>Ringkasan Pengaturan</h6>
          <a href="/customer/settings" class="btn btn-sm btn-outline-primary">Ubah</a>
        </div>
        <div class="card-body">
          <ul class="list-unstyled mb-0">
            <li class="mb-2"><i class="fas fa-bell me-2"></i>Notifikasi WhatsApp: <strong><%= settings.notify_whatsapp ? 'Aktif' : 'Nonaktif' %></strong></li>
            <li class="mb-2"><i class="fas fa-pepper-hot me-2"></i>Level Pedas Default: <strong><%= ({0:'Tidak Pedas',1:'Sedikit',2:'Sedang',3:'Pedas'})[settings.default_spicy_level || 0] %></strong></li>
            <li class="mb-2"><i class="fas fa-lemon me-2"></i>Sambal Default: <strong><%= settings.default_sambal_type || 'Tidak ada' %></strong></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/customer-end') %>
