<%- include('../layouts/customer-start', {
  title: 'Pesanan Saya',
  page: 'orders',
  user: user,
  cartCount: cartCount
}) %>

<div class="container">
  <div class="row mb-4">
    <div class="col-12">
      <div class="card card-custom">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>Riwayat Pesanan</h5>
          <span class="badge bg-primary"><%= orders.length %> pesanan</span>
        </div>
        <div class="card-body">
          <% if (!orders || orders.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">Belum ada pesanan</h5>
              <p class="text-muted">Pesanan Anda akan muncul di sini setelah checkout</p>
              <a href="/customer/order" class="btn btn-primary"><i class="fas fa-utensils me-2"></i>Pesan Sekarang</a>
            </div>
          <% } else { %>
            <% orders.forEach(function(order){ %>
              <div class="card mb-3 shadow-sm">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                      <strong class="text-primary">Invoice: <%= order.invoice %></strong><br>
                      <small class="text-muted"><i class="fas fa-clock me-1"></i><%= moment(order.created_at).format('DD/MM/YY HH:mm') %></small>
                    </div>
                    <div class="text-end">
                      <% var badgeClass = 'bg-secondary'; if (order.status === 'pending') { badgeClass = 'bg-warning'; } else if (order.status === 'rejected') { badgeClass = 'bg-danger'; } %>
                      <span class="badge <%= badgeClass %>">Status: <%= order.status_label || order.status %></span><br>
                      <% if (order.status === 'pending') { %>
                        <small class="text-muted">Menunggu persetujuan admin</small><br>
                      <% } %>
                      <strong>Total: Rp <%= Number(order.total).toLocaleString('id-ID') %></strong>
                    </div>
                  </div>

                  <!-- Timeline Status -->
                  <div class="timeline mb-3" data-created-at="<%= order.created_at %>" data-status="<%= order.status %>">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                      <% 
                        var reached = true;
                        order.timeline.forEach(function(step){ 
                          var active = reached;
                          if (step.key === order.status) { reached = false; }
                      %>
                        <div class="d-flex align-items-center">
                          <div class="step-circle <%= active ? 'bg-success text-white' : 'bg-light text-muted' %>">
                            <i class="fas fa-<%= step.icon %>"></i>
                          </div>
                          <div class="ms-2">
                            <div class="small <%= active ? 'fw-semibold' : 'text-muted' %>"><%= step.label %></div>
                          </div>
                        </div>
                        <div class="step-line <%= reached ? 'bg-secondary' : 'bg-light' %>"></div>
                      <% }) %>
                    </div>
                  </div>

                  <!-- Items -->
                  <div class="table-responsive">
                    <table class="table table-sm mb-0">
                      <thead>
                        <tr>
                          <th>Item</th>
                          <th class="text-end">Qty</th>
                          <th class="text-end">Harga</th>
                          <th class="text-end">Subtotal</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% order.items.forEach(function(it){ %>
                          <tr>
                            <td><%= it.name %></td>
                            <td class="text-end"><%= it.quantity %></td>
                            <td class="text-end">Rp <%= Number(it.price).toLocaleString('id-ID') %></td>
                            <td class="text-end">Rp <%= Number(it.price * it.quantity).toLocaleString('id-ID') %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>

    <div class="card card-custom mt-4">
        <div class="card-header d-flex justify-content-between align-items-center bg-gradient-info text-white" style="background: linear-gradient(135deg, #0dcaf0 0%, #087990 100%);">
          <h5 class="mb-0 text-white"><i class="fas fa-helicopter me-2"></i>Riwayat Pengiriman Drone</h5>
          <span class="badge bg-light text-dark"><%= typeof deliveries !== 'undefined' ? deliveries.length : 0 %> pengiriman</span>
        </div>
        <div class="card-body">
          <% if (!deliveries || deliveries.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">Belum ada pengiriman</h5>
              <p class="text-muted">Riwayat paket drone Anda akan muncul di sini.</p>
              <a href="/customer/send" class="btn btn-info text-white"><i class="fas fa-paper-plane me-2"></i>Kirim Paket</a>
            </div>
          <% } else { %>
            <% deliveries.forEach(function(delivery){ %>
              <div class="card mb-3 shadow-sm" style="border-left: 4px solid #0dcaf0;">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                      <strong class="text-info">Resi: DRX-<%= delivery.id %></strong><br>
                      <small class="text-muted"><i class="fas fa-clock me-1"></i><%= moment(delivery.created_at).format('DD/MM/YY HH:mm') %></small>
                    </div>
                    <div class="text-end">
                      <% var bClass = 'bg-secondary'; if (delivery.status === 'pending') { bClass = 'bg-warning'; } else if (delivery.status === 'completed') { bClass = 'bg-success'; } %>
                      <span class="badge <%= bClass %>">Status: <%= delivery.status.toUpperCase() %></span><br>
                      <strong><%= delivery.delivery_type === 'setpoint' ? 'Loker (Setpoint)' : 'Alamat Langsung' %></strong>
                    </div>
                  </div>

                  <div class="bg-light p-3 rounded">
                    <div class="row">
                      <div class="col-md-6 mb-2 mb-md-0">
                        <small class="text-muted d-block fw-bold">Penerima:</small>
                        <span><%= delivery.receiver_name %> (<%= delivery.receiver_phone %>)</span>
                      </div>
                      <div class="col-md-6">
                        <small class="text-muted d-block fw-bold">Tujuan / Loker:</small>
                        <span><%= delivery.delivery_type === 'setpoint' ? delivery.setpoint_location : delivery.receiver_address %></span>
                      </div>
                    </div>
                    <hr class="my-2">
                    <div class="row align-items-center">
                      <div class="col-md-6">
                        <small class="text-muted d-block fw-bold">Paket:</small>
                        <span class="text-capitalize"><%= delivery.item_category %> (<%= delivery.item_weight %> Kg)</span>
                      </div>
                      <% if (delivery.delivery_type === 'setpoint' && delivery.pickup_pin) { %>
                      <div class="col-md-6 text-md-end mt-2 mt-md-0">
                        <span class="badge bg-danger p-2 fs-6 shadow-sm"><i class="fas fa-lock me-1"></i> PIN Loker: <%= delivery.pickup_pin %></span>
                      </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

  </div>
</div>

<style>
  .timeline .step-circle { width: 34px; height: 34px; border-radius: 50%; display:flex; align-items:center; justify-content:center; }
  .timeline .step-line { width: 40px; height: 3px; border-radius: 2px; margin: 0 8px; }
</style>

 

<%- include('../layouts/customer-end') %>
