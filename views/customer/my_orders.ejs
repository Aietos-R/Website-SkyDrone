<%- include('../layouts/customer-start', {
  title: 'Pesanan Saya',
  page: 'orders',
  user: user,
  cartCount: cartCount
}) %>

<div class="container">
  <div class="row mb-4">
    <div class="col-12">
      <div class="card card-custom">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>Riwayat Pesanan</h5>
          <span class="badge bg-primary"><%= orders.length %> pesanan</span>
        </div>
        <div class="card-body">
          <% if (!orders || orders.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">Belum ada pesanan</h5>
              <p class="text-muted">Pesanan Anda akan muncul di sini setelah checkout</p>
              <a href="/customer/order" class="btn btn-primary"><i class="fas fa-utensils me-2"></i>Pesan Sekarang</a>
            </div>
          <% } else { %>
            <% orders.forEach(function(order){ %>
              <div class="card mb-3 shadow-sm">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                      <strong class="text-primary">Invoice: <%= order.invoice %></strong><br>
                      <small class="text-muted"><i class="fas fa-clock me-1"></i><%= moment(order.created_at).format('DD/MM/YY HH:mm') %></small>
                    </div>
                    <div class="text-end">
                      <% var badgeClass = 'bg-secondary'; if (order.status === 'pending') { badgeClass = 'bg-warning'; } else if (order.status === 'rejected') { badgeClass = 'bg-danger'; } %>
                      <span class="badge <%= badgeClass %>">Status: <%= order.status_label || order.status %></span><br>
                      <% if (order.status === 'pending') { %>
                        <small class="text-muted">Menunggu persetujuan admin</small><br>
                      <% } %>
                      <strong>Total: Rp <%= Number(order.total).toLocaleString('id-ID') %></strong>
                    </div>
                  </div>

                  <!-- Timeline Status -->
                  <div class="timeline mb-3" data-created-at="<%= order.created_at %>" data-status="<%= order.status %>">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                      <% 
                        var reached = true;
                        order.timeline.forEach(function(step){ 
                          var active = reached;
                          if (step.key === order.status) { reached = false; }
                      %>
                        <div class="d-flex align-items-center">
                          <div class="step-circle <%= active ? 'bg-success text-white' : 'bg-light text-muted' %>">
                            <i class="fas fa-<%= step.icon %>"></i>
                          </div>
                          <div class="ms-2">
                            <div class="small <%= active ? 'fw-semibold' : 'text-muted' %>"><%= step.label %></div>
                          </div>
                        </div>
                        <div class="step-line <%= reached ? 'bg-secondary' : 'bg-light' %>"></div>
                      <% }) %>
                    </div>
                  </div>

                  <!-- Items -->
                  <div class="table-responsive">
                    <table class="table table-sm mb-0">
                      <thead>
                        <tr>
                          <th>Item</th>
                          <th class="text-end">Qty</th>
                          <th class="text-end">Harga</th>
                          <th class="text-end">Subtotal</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% order.items.forEach(function(it){ %>
                          <tr>
                            <td><%= it.name %></td>
                            <td class="text-end"><%= it.quantity %></td>
                            <td class="text-end">Rp <%= Number(it.price).toLocaleString('id-ID') %></td>
                            <td class="text-end">Rp <%= Number(it.price * it.quantity).toLocaleString('id-ID') %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .timeline .step-circle { width: 34px; height: 34px; border-radius: 50%; display:flex; align-items:center; justify-content:center; }
  .timeline .step-line { width: 40px; height: 3px; border-radius: 2px; margin: 0 8px; }
</style>

 

<%- include('../layouts/customer-end') %>
