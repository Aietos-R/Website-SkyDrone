<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
      <a class="navbar-brand" href="/">Ayam Geprek Arema</a>
      <a class="btn btn-outline-primary" href="/customer/order">Pesan Online</a>
    </div>
  </nav>

  <div class="container py-4">
    <div class="alert alert-success">
      Reservasi berhasil dikirim. Kami akan menghubungi Anda melalui WhatsApp untuk konfirmasi.
    </div>
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
      <div id="reservationToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
          <div class="toast-body">
            Reservasi dikirim: <strong><%= reservation.date %></strong> <%= reservation.time %>, <%= reservation.party_size %> orang.
          </div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-body">
        <h5 class="mb-3">Detail Reservasi</h5>
        <div class="row">
          <div class="col-md-6">
            <div>Nama</div>
            <strong><%= reservation.name %></strong>
          </div>
          <div class="col-md-6">
            <div>No. WhatsApp</div>
            <strong><%= reservation.phone %></strong>
          </div>
          <div class="col-md-4 mt-3">
            <div>Tanggal</div>
            <strong><%= reservation.date %></strong>
          </div>
          <div class="col-md-4 mt-3">
            <div>Waktu</div>
            <strong><%= reservation.time %></strong>
          </div>
          <div class="col-md-4 mt-3">
            <div>Jumlah Orang</div>
            <strong><%= reservation.party_size %></strong>
          </div>
        </div>
      </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-3">
      <a href="/customer/reservations" class="btn btn-primary">Lihat Reservasi Saya</a>
      <a href="/customer/order" class="btn btn-secondary">Kembali ke Menu</a>
    </div>
  </div>

  <footer class="py-4 text-center text-muted">
    <small>© <%= new Date().getFullYear() %> Rendy Cristian Boen</small>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var toastEl = document.getElementById('reservationToast');
      if (toastEl) {
        var toast = new bootstrap.Toast(toastEl, { delay: 5000 });
        toast.show();
      }
    });
  </script>
</body>
</html>
