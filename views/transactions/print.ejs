<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: #f8f9fa;
      padding: 24px;
    }
    .invoice-card {
      max-width: 720px;
      margin: 0 auto;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      padding: 32px;
    }
    .invoice-header {
      border-bottom: 2px dashed #e9ecef;
      margin-bottom: 24px;
      padding-bottom: 16px;
    }
    .totals-row {
      background: #fef1eb;
      border-radius: 12px;
      padding: 16px;
    }
    @media print {
      body {
        background: #fff;
        padding: 0;
      }
      .invoice-card {
        box-shadow: none;
        border: 1px solid #e9ecef;
      }
      .print-actions {
        display: none !important;
      }
    }
  </style>
</head>
<body>
  <div class="invoice-card">
    <div class="d-flex justify-content-between align-items-center invoice-header">
      <div>
        <h4 class="mb-1">Ayam Geprek Arema</h4>
        <p class="text-muted mb-0">Invoice #: <strong><%= transaction.invoice %></strong></p>
      </div>
      <div class="text-end">
        <p class="mb-0">Tanggal</p>
        <h6 class="mb-0"><%= moment(transaction.transaction_date).format('DD MMMM YYYY HH:mm') %></h6>
      </div>
    </div>

    <div class="row mb-4">
      <div class="col-md-6">
        <small class="text-muted d-block">Customer</small>
        <strong><%= transaction.customer_name %></strong>
      </div>
      <div class="col-md-6 text-md-end">
        <small class="text-muted d-block">Kasir</small>
        <strong><%= transaction.cashier %></strong>
      </div>
    </div>

    <div class="table-responsive mb-4">
      <table class="table">
        <thead class="table-light">
          <tr>
            <th>Menu</th>
            <th class="text-center">Qty</th>
            <th class="text-end">Harga</th>
            <th class="text-end">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
          <tr>
            <td><%= item.menu_name %></td>
            <td class="text-center"><%= item.quantity %></td>
            <td class="text-end">Rp <%= Number(item.price).toLocaleString('id-ID') %></td>
            <td class="text-end">Rp <%= (item.price * item.quantity).toLocaleString('id-ID') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="totals-row mb-4">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <small class="text-muted d-block">Metode Pembayaran</small>
          <strong class="text-uppercase"><%= transaction.payment_method %></strong>
        </div>
        <div class="text-end">
          <small class="text-muted d-block">Total Pembayaran</small>
          <h3 class="mb-0 text-success">Rp <%= Number(transaction.total).toLocaleString('id-ID') %></h3>
        </div>
      </div>
    </div>

    <p class="text-center text-muted mb-0">
      Terima kasih telah bertransaksi di Ayam Geprek Arema.
    </p>
  </div>

  <div class="text-center mt-3 print-actions">
    <a href="/transactions" class="btn btn-outline-secondary me-2">Kembali</a>
    <button class="btn btn-primary" onclick="window.print()">
      <i class="fas fa-print me-2"></i> Cetak
    </button>
  </div>
</body>
</html>

